# Cliente Supabase (pode ficar em variaveis VITE_, a anon key e publica por design)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Defina "true" para ativar o Supabase. Sem URL/chave preenchidas,
# o app cai automaticamente em modo demonstracao (dados no navegador).
VITE_USE_SUPABASE=true

# Base path para GitHub Pages (ex.: /pontoflow/). Em dev deixe vazio.
VITE_BASE=
